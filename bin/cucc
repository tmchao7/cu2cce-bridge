#!/bin/bash
# ============================================================
# cucc —— nvcc 兼容编译器驱动（Phase A2 完整版）
#
# 仿照 cu-bridge 的 bin/cucc（Apache-2.0），目标编译器从 mxcc 换成
# 昇腾 bisheng（CANN 的 clang 系编译器）。核心职责：
#   1. 解析/展开 nvcc 命令行（含 @file / --options-file、-D 宏、-Xcompiler）
#   2. 识别编译单元（.cu / .cpp / .o）与阶段（compile / link）
#   3. 注入 cu2cce-bridge 的 CUDA 兼容头 + SIMT 原语适配头
#   4. 把 CUDA 特有参数翻译成 ccec 参数（架构/标准/链接库）
#   5. 直接调用 ccec
#
# ⚠️ 本机（macOS）无 CANN/bisheng，脚本仅作框架，勿在本机执行。
#    真机环境见 docs/01_Design/CUDA_TO_CCE_PORTING_PLAN.md §6。
# ============================================================
set -u

# ---------------- 环境 ----------------
CUCC_PATH=${CUCC_PATH:-}
ASCEND_TOOLKIT_HOME=${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}
CANN_BASE=${CANN_BASE:-/usr/local/Ascend/latest}
# main/puresimt 唯一编译器：CANN 自带 ccec。
# 旧 bisheng fallback 与旧无-SIMT 路线不属于 main。
CCEC_PATH=${CCEC_PATH:-}
CC_CMD=""
if [ -z "${CCEC_PATH}" ]; then
    for cand in \
        "${CANN_BASE}/bin/ccec" \
        /usr/local/Ascend/latest/bin/ccec \
        /usr/local/Ascend/cann-*/bin/ccec; do
        if [ -x "${cand}" ]; then CCEC_PATH="${cand}"; break; fi
    done
fi
if [ -n "${CCEC_PATH}" ] && [ -x "${CCEC_PATH}" ]; then
    CC_CMD="${CCEC_PATH}"
else
    echo "cucc: main/puresimt requires CANN ccec; set CCEC_PATH or install /usr/local/Ascend/latest/bin/ccec" >&2
    exit 1
fi
# 目标 NPU 架构：puresimt 真机基线必须使用 dav-c310-vec。
CUCC_NPU_ARCH=${CUCC_NPU_ARCH:-dav-c310-vec}
# 模拟的 CUDA 版本
CUCC_CUDA_VERSION=${CUCC_CUDA_VERSION:-11060}
# 调试开关
WCUDA_DEBUG=${WCUDA_DEBUG:-0}

debug_echo() {
    if [ "${WCUDA_DEBUG}" == "1" ]; then
        echo "/* $1 */" >&2
    fi
}

# ---------------- 参数预处理（仿照 cu-bridge） ----------------
listp=()

# 展开 @file / --options-file / -options-file
for i in "$@"; do
    if [[ "${i}" == @* ]]; then
        file="${i:1}"
        if [[ -f "${file}" ]]; then
            while read -r line; do
                for j in ${line}; do
                    listp+=("${j}")
                done
            done < <(cat "${file}"; echo "")
        fi
        continue
    fi
    if [[ "${i}" == "--options-file" ]]; then
        # 下一个参数是文件名
        continue
    fi
    listp+=("${i}")
done

# 展开 "--options-file file"（上面的循环把 file 当作普通参数，这里二次扫描修正）
newlistp=()
skip_next=0
for i in "${listp[@]}"; do
    if [[ "${i}" == "--options-file" || "${i}" == "-options-file" ]]; then
        skip_next=1
        continue
    fi
    if [[ ${skip_next} -eq 1 ]]; then
        skip_next=0
        if [[ -f "${i}" ]]; then
            while read -r line; do
                for j in ${line}; do
                    newlistp+=("${j}")
                done
            done < <(cat "${i}"; echo "")
        fi
        continue
    fi
    newlistp+=("${i}")
done
listp=("${newlistp[@]}")

# ---------------- 识别编译单元与阶段 ----------------
# -x cu / .cu → device 侧（ccec 直接编译）
# -x cpp / .cpp/.c/.cc → host 侧
# *.o → 链接阶段
xlang=""
dotofilefound=0
for i in "${listp[@]}"; do
    case "${i}" in
        *.cu)  xlang="cu";;
        *.cpp|*.cc|*.cxx) xlang="cpp";;
        *.c)   xlang="c";;
        *.o)   dotofilefound=1;;
    esac
done

# ---------------- 追加参数 ----------------
params=("${listp[@]}")

# puresimt 主线：.cu 直接交给 CANN ccec。
# 不运行 Python kernel converter，不生成 __simt_vf__/__global__[aicore] 包装，
# 不注入隐藏 block 参数；用户 CUDA 源文件保持原样，由 ccec --enable-simt
# 直接解析 __global__/threadIdx/blockIdx/__shared__/<<<>>>。
# 注入 cu2cce-bridge 的 CUDA 兼容头（shadow 遮蔽头最优先：用户代码
# #include <stdio.h> 等命中 cu2cce 最小声明版，不碰 glibc——ccec+glibc 2.39
# 系统头不兼容，真机实测；用户 CUDA 代码保持原样不动）
if [ -n "${CUCC_PATH}" ]; then
    if [ -d "${CUCC_PATH}/include/shadow" ]; then
        params+=("-I" "${CUCC_PATH}/include/shadow")
    fi
    params+=("-I" "${CUCC_PATH}/include")
    # Installed NVIDIA CUDA Samples helper headers are optional dependencies;
    # include them when present without changing user source.
    if [ -d "${CUCC_PATH}/third_party/nvidia_cuda_samples/Common" ]; then
        params+=("-I" "${CUCC_PATH}/third_party/nvidia_cuda_samples/Common")
    fi
fi
# 注入昇腾 ACL 头
params+=("-I" "${ASCEND_TOOLKIT_HOME}/include")

# simt_api 头父目录（simt_adaptor.h include "simt_api/asc_simt.h" 需要；
# 真机布局：cann-9.2.0/x86_64-linux/asc/include；可用 SIMT_API_ROOT 覆盖）
if [ -z "${SIMT_API_ROOT:-}" ]; then
    for cand in \
        /usr/local/Ascend/cann-*/x86_64-linux/asc/include \
        "${ASCEND_TOOLKIT_HOME}"/x86_64-linux/asc/include \
        /usr/local/Ascend/cann-*/aarch64-linux/asc/include; do
        if [ -d "${cand}/simt_api" ]; then SIMT_API_ROOT="${cand}"; break; fi
    done
fi
if [ -n "${SIMT_API_ROOT:-}" ] && [ -d "${SIMT_API_ROOT}/simt_api" ]; then
    params+=("-I" "${SIMT_API_ROOT}")
    # simt_api 头链深层依赖在 asc 根目录（impl/utils/sys_macros.h 等，真机实测
    # 位于 cann-9.2.0/x86_64-linux/asc/impl/，不在 asc/include 下）
    params+=("-I" "$(dirname "${SIMT_API_ROOT}")")
fi

# SIMT 适配宏表：编译 device 侧（.cu）时强制注入
if [[ "${xlang}" == "cu" ]]; then
    if [ -n "${CUCC_PATH}" ] && [ -f "${CUCC_PATH}/include/bridge/kernel/simt_adaptor.h" ]; then
        params+=("-include" "${CUCC_PATH}/include/bridge/kernel/simt_adaptor.h")
    fi
fi

# C++17（昇腾编译 Ascend C/SIMT 必选；gnu 模式避免 __STRICT_ANSI__ 裁剪 glibc 声明）
params+=("-std=gnu++17")

# ccec(clang15)+glibc 2.39 系统头不可用（真机实测连锁错误）：桥接头按此宏
# 提供简化实现 + 最小 C 运行库声明（见 __cuda_runtime.h / cuda_wrapper_internal.h）
params+=("-D" "__CU2CCE_NO_LIBC__")

# 模拟 CUDA 版本
params+=("-D" "CUDA_VERSION=${CUCC_CUDA_VERSION}")

# puresimt 架构（ccec 唯一主线）。
params+=("--cce-aicore-arch=${CUCC_NPU_ARCH}")
if [[ "${xlang}" == "cu" ]]; then
    params+=("--enable-simt")
fi

# 设备侧代码标注（ccec 用 -xcce 识别含设备代码的源）
if [[ "${xlang}" == "cu" ]]; then
    params+=("-xcce")
fi

# 链接阶段：追加昇腾运行库（clang 风格 -L/-l；真机实测：
# CCE 运行时 rt* 符号（rtKernelLaunch 等）在 ${CANN_BASE}/runtime/lib64 的 -lruntime，
# 用户实测脚本 04_build_exec.sh 同款）
if [[ ${dotofilefound} -eq 1 ]]; then
    params+=("-L" "${ASCEND_TOOLKIT_HOME}/lib64")
    params+=("-L" "${CANN_BASE}/runtime/lib64")
    params+=("-L" "${CANN_BASE}/lib64")
    params+=("-lascendcl")   # 或 -lacl_rt，视 CANN 版本
    params+=("-lruntime")    # CCE 运行时（rtKernelLaunch/rtFunctionRegister 等）
    params+=("-lstdc++" "-lpthread" "-lm")
fi

# 链接时注入 cu2cce 的 wcuda* wrapper 库（并写 rpath 指向它，
    # 运行时不需手工设 LD_LIBRARY_PATH）
    if [[ ${dotofilefound} -eq 1 ]] && [ -n "${CUCC_PATH}" ]; then
        params+=("-L" "${CUCC_PATH}/lib")
        params+=("-Wl,-rpath,${CUCC_PATH}/lib")
        params+=("-lcce_bridge_runtime")
        # 昇腾库 rpath（真机：libascendcl 等依赖 CANN lib64/driver；运行需找到）
        params+=("-Wl,-rpath,${ASCEND_TOOLKIT_HOME}/lib64")
        params+=("-Wl,-rpath,${CANN_BASE}/lib64")
        params+=("-Wl,-rpath,${CANN_BASE}/runtime/lib64")
    fi

debug_echo "final cmd: ${CC_CMD} ${params[*]}"

# ---------------- 调用 ccec ----------------
if [ ! -x "${CC_CMD}" ]; then
    echo "cucc: cannot find compiler at ${CC_CMD}" >&2
    echo "      set CCEC_PATH or check /usr/local/Ascend/latest/bin/ccec" >&2
    exit 1
fi

exec "${CC_CMD}" "${params[@]}"

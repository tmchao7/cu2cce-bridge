#!/bin/bash
# ============================================================
# cucc —— nvcc 兼容编译器驱动（Phase A2 完整版）
#
# 仿照 cu-bridge 的 bin/cucc（Apache-2.0），目标编译器从 mxcc 换成
# 昇腾 bisheng（CANN 的 clang 系编译器）。核心职责：
#   1. 解析/展开 nvcc 命令行（含 @file / --options-file、-D 宏、-Xcompiler）
#   2. 识别编译单元（.cu / .cpp / .o）与阶段（compile / link）
#   3. 注入 cu2cce-bridge 的 CUDA 兼容头 + SIMT 适配宏表
#   4. 把 CUDA 特有参数翻译成 bisheng 参数（--offload-arch → --npu-arch=dav-c310 等）
#   5. 调用 bisheng
#
# ⚠️ 本机（macOS）无 CANN/bisheng，脚本仅作框架，勿在本机执行。
#    真机环境见 docs/01_Design/CUDA_TO_CCE_PORTING_PLAN.md §6。
# ============================================================
set -u

# ---------------- 环境 ----------------
CUCC_PATH=${CUCC_PATH:-}
ASCEND_TOOLKIT_HOME=${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}
CANN_BASE=${CANN_BASE:-/usr/local/Ascend/latest}
# 编译器选择（真机 9.2.0 实测，2026-08-19）：
#   1. ccec（CANN 自带，/usr/local/Ascend/latest/bin/ccec）——架构参数 --cce-aicore-arch=dav-c310，
#      导师指定的 dav-c310 只有 ccec 认识；用户实测脚本已用它编译+运行成功 → 优先
#   2. bisheng（独立编译器）——架构参数 --npu-arch=dav-xxx（不认识 dav-c310）
CCEC_PATH=${CCEC_PATH:-}
BISHENG_PATH=${BISHENG_PATH:-}
CCE_ARCH_FLAG="--npu-arch"
CC_CMD=""
if [ -z "${CCEC_PATH}" ]; then
    for cand in \
        "${CANN_BASE}/bin/ccec" \
        /usr/local/Ascend/latest/bin/ccec \
        /usr/local/Ascend/cann-*/bin/ccec; do
        if [ -x "${cand}" ]; then CCEC_PATH="${cand}"; break; fi
    done
fi
if [ -n "${CCEC_PATH}" ] && [ -x "${CCEC_PATH}" ]; then
    CC_CMD="${CCEC_PATH}"
    CCE_ARCH_FLAG="--cce-aicore-arch"
else
    if [ -z "${BISHENG_PATH}" ]; then
        for cand in \
            "${ASCEND_TOOLKIT_HOME}/compiler/ccec_compiler/bin/bisheng" \
            "${ASCEND_TOOLKIT_HOME}/compiler/bisheng/bin/bisheng" \
            /usr/local/Ascend/cann-*/tools/bisheng_compiler/bin/bisheng; do
            if [ -x "${cand}" ]; then BISHENG_PATH="${cand}"; break; fi
        done
        BISHENG_PATH=${BISHENG_PATH:-${ASCEND_TOOLKIT_HOME}/compiler/ccec_compiler/bin/bisheng}
    fi
    CC_CMD="${BISHENG_PATH}"
    CCE_ARCH_FLAG="--npu-arch"
fi
# 目标 NPU 架构（D0 已定：950 系列 = dav-c310；导师 2026-08-19 纠正，此前误记 dav-310）
CUCC_NPU_ARCH=${CUCC_NPU_ARCH:-dav-c310}
# 模拟的 CUDA 版本
CUCC_CUDA_VERSION=${CUCC_CUDA_VERSION:-11060}
# 调试开关
WCUDA_DEBUG=${WCUDA_DEBUG:-0}

debug_echo() {
    if [ "${WCUDA_DEBUG}" == "1" ]; then
        echo "/* $1 */" >&2
    fi
}

# ---------------- 参数预处理（仿照 cu-bridge） ----------------
listp=()

# 展开 @file / --options-file / -options-file
for i in "$@"; do
    if [[ "${i}" == @* ]]; then
        file="${i:1}"
        if [[ -f "${file}" ]]; then
            while read -r line; do
                for j in ${line}; do
                    listp+=("${j}")
                done
            done < <(cat "${file}"; echo "")
        fi
        continue
    fi
    if [[ "${i}" == "--options-file" ]]; then
        # 下一个参数是文件名
        continue
    fi
    listp+=("${i}")
done

# 展开 "--options-file file"（上面的循环把 file 当作普通参数，这里二次扫描修正）
newlistp=()
skip_next=0
for i in "${listp[@]}"; do
    if [[ "${i}" == "--options-file" || "${i}" == "-options-file" ]]; then
        skip_next=1
        continue
    fi
    if [[ ${skip_next} -eq 1 ]]; then
        skip_next=0
        if [[ -f "${i}" ]]; then
            while read -r line; do
                for j in ${line}; do
                    newlistp+=("${j}")
                done
            done < <(cat "${i}"; echo "")
        fi
        continue
    fi
    newlistp+=("${i}")
done
listp=("${newlistp[@]}")

# ---------------- 识别编译单元与阶段 ----------------
# -x cu / .cu → device 侧（bisheng 直接编译）
# -x cpp / .cpp/.c/.cc → host 侧
# *.o → 链接阶段
xlang=""
dotofilefound=0
for i in "${listp[@]}"; do
    case "${i}" in
        *.cu)  xlang="cu";;
        *.cpp|*.cc|*.cxx) xlang="cpp";;
        *.c)   xlang="c";;
        *.o)   dotofilefound=1;;
    esac
done

# ---------------- 追加参数 ----------------
params=("${listp[@]}")

# kernel 自动转换：用户 .cu 保持纯 CUDA（零改写），编译前用 kernel_convert.py
# 转为昇腾 SIMT VF 模板（对应 cu-bridge 的 ptx2cpp 职责，2026-08-19）
if [[ "${xlang}" == "cu" ]]; then
    KERNEL_CONVERT=""
    if [ -n "${CUCC_PATH}" ] && [ -f "${CUCC_PATH}/tools/kernel_convert.py" ]; then
        KERNEL_CONVERT="${CUCC_PATH}/tools/kernel_convert.py"
    elif [ -f "$(dirname "$0")/../tools/kernel_convert.py" ]; then
        KERNEL_CONVERT="$(cd "$(dirname "$0")/../tools" && pwd)/kernel_convert.py"
    fi
    if [ -n "${KERNEL_CONVERT}" ]; then
        for idx in "${!params[@]}"; do
            case "${params[$idx]}" in
                *.cu)
                    conv="$(mktemp /tmp/cu2cce_XXXXXX.cce)"
                    if python3 "${KERNEL_CONVERT}" "${params[$idx]}" -o "${conv}" >/dev/null 2>&1; then
                        debug_echo "kernel_convert: ${params[$idx]} -> ${conv}"
                        params[$idx]="${conv}"
                    else
                        echo "cucc: kernel_convert failed for ${params[$idx]}" >&2
                        rm -f "${conv}"
                        exit 1
                    fi
                    break;;
            esac
        done
    fi
fi

# 注入 cu2cce-bridge 的 CUDA 兼容头
if [ -n "${CUCC_PATH}" ]; then
    params+=("-I" "${CUCC_PATH}/include")
fi
# 注入昇腾 ACL 头
params+=("-I" "${ASCEND_TOOLKIT_HOME}/include")

# simt_api 头父目录（simt_adaptor.h include "simt_api/asc_simt.h" 需要；
# 真机布局：cann-9.2.0/x86_64-linux/asc/include；可用 SIMT_API_ROOT 覆盖）
if [ -z "${SIMT_API_ROOT:-}" ]; then
    for cand in \
        /usr/local/Ascend/cann-*/x86_64-linux/asc/include \
        "${ASCEND_TOOLKIT_HOME}"/x86_64-linux/asc/include \
        /usr/local/Ascend/cann-*/aarch64-linux/asc/include; do
        if [ -d "${cand}/simt_api" ]; then SIMT_API_ROOT="${cand}"; break; fi
    done
fi
if [ -n "${SIMT_API_ROOT:-}" ] && [ -d "${SIMT_API_ROOT}/simt_api" ]; then
    params+=("-I" "${SIMT_API_ROOT}")
    # simt_api 头链深层依赖在 asc 根目录（impl/utils/sys_macros.h 等，真机实测
    # 位于 cann-9.2.0/x86_64-linux/asc/impl/，不在 asc/include 下）
    params+=("-I" "$(dirname "${SIMT_API_ROOT}")")
fi

# SIMT 适配宏表：编译 device 侧（.cu）时强制注入
if [[ "${xlang}" == "cu" ]]; then
    if [ -n "${CUCC_PATH}" ] && [ -f "${CUCC_PATH}/include/bridge/kernel/simt_adaptor.h" ]; then
        params+=("-include" "${CUCC_PATH}/include/bridge/kernel/simt_adaptor.h")
    fi
fi

# C++17（昇腾编译 Ascend C/SIMT 必选）
params+=("-std=c++17")

# glibc 2.39（Ubuntu 24.04）math.h 的 _Float32 与 ccec(clang15) 不兼容（真机实测），
# 跳过系统 math.h（__cuda_runtime.h 检查此宏）
params+=("-D" "__CU2CCE_NO_MATH_H__")

# 模拟 CUDA 版本
params+=("-D" "CUDA_VERSION=${CUCC_CUDA_VERSION}")

# NPU 架构（D0 已定：dav-c310；ccec 用 --cce-aicore-arch，bisheng 用 --npu-arch）
params+=("${CCE_ARCH_FLAG}=${CUCC_NPU_ARCH}")

# 设备侧代码标注（编译 .cu 时 bisheng 需要 -xcce 识别含设备代码的源）
if [[ "${xlang}" == "cu" ]]; then
    params+=("-xcce")
fi

# 链接阶段：追加昇腾运行库（clang 风格 -L/-l）
if [[ ${dotofilefound} -eq 1 ]]; then
    params+=("-L" "${ASCEND_TOOLKIT_HOME}/lib64")
    params+=("-lascendcl")   # 或 -lacl_rt，视 CANN 版本
fi

# 链接时注入 cu2cce 的 wcuda* wrapper 库
if [[ ${dotofilefound} -eq 1 ]] && [ -n "${CUCC_PATH}" ]; then
    params+=("-L" "${CUCC_PATH}/lib")
    params+=("-lcce_bridge_runtime")
fi

debug_echo "final cmd: ${CC_CMD} ${params[*]}"

# ---------------- 调用编译器（ccec 优先，bisheng 兜底） ----------------
if [ ! -f "${CC_CMD}" ]; then
    echo "cucc: cannot find compiler at ${CC_CMD}" >&2
    echo "      set CCEC_PATH（CANN 自带 ccec）或 BISHENG_PATH，或检查 /usr/local/Ascend/latest" >&2
    exit 1
fi

exec "${CC_CMD}" "${params[@]}"

#!/bin/bash
# cucc —— compatibility entrypoint for the rule-driven cu2cce driver.
#
# The driver handles response files, compile/link phase detection, CUDA
# argument policy, diagnostics, and ccec invocation. It never reads or rewrites
# CUDA source code.
set -euo pipefail

CUCC_PATH="${CUCC_PATH:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "$CUCC_PATH" ]; then
    CUCC_PATH="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
DRIVER="${CU2CCE_DRIVER:-$CUCC_PATH/tools/cu2cce_driver.py}"
if [ ! -f "$DRIVER" ]; then
    DRIVER="$(cd "$SCRIPT_DIR/.." && pwd)/tools/cu2cce_driver.py"
fi
if [ ! -f "$DRIVER" ]; then
    echo "cucc: rule driver not found; expected $CUCC_PATH/tools/cu2cce_driver.py" >&2
    exit 1
fi

export CUCC_PATH

# Debug-state propagation (cu-bridge make_maca <-> cucc parity): make_cce/
# pre_cce export BASH_XTRACE/BASH_VERBOSE/BASH_ERREXIT to mirror their own
# shell flags; the driver is python, so surface that state as CU2CCE_DEBUG.
if [ "${BASH_XTRACE:-0}" = "1" ] || [ "${BASH_VERBOSE:-0}" = "1" ] || [ "${BASH_ERREXIT:-0}" = "1" ]; then
    export CU2CCE_DEBUG="${CU2CCE_DEBUG:-1}"
fi

exec python3 "$DRIVER" "$@"

#!/bin/bash
# Reference-shaped host compiler carrier. The implementation remains in the
# Ascend-aware tools/hostcc_cce wrapper; this file is a stable bin/gnu entry.
# Resolve the real file before deriving SCRIPT_DIR: virtualDir.py may expose
# this entry through generated c++/g++/gcc/cc symlinks.
set -u
INVOKED_NAME="$(basename "${BASH_SOURCE[0]}")"
case "$INVOKED_NAME" in
    c++|g++|gcc|cc) DEFAULT_HOSTCC_NAME="$INVOKED_NAME" ;;
    *) DEFAULT_HOSTCC_NAME="g++" ;;
esac
SCRIPT_PATH="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
export CU2CCE_HOSTCC_NAME="${CU2CCE_HOSTCC_NAME:-$DEFAULT_HOSTCC_NAME}"
exec "$SCRIPT_DIR/../tools/hostcc_cce" "$@"

# ============================================================
# cu2cce-bridge .gitignore
# 本机 macOS 无 CANN 不构建；以下主要为真机构建/开发准备。
# ============================================================

# macOS
.DS_Store
**/.DS_Store

# 构建产物
/build/
build/
build_out/
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.exe
a.out

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
CMakePresets.json.local

# cucc/make_cce 临时工作目录（对应 cu-bridge 的 CUBRIDGE_HOME）
# 默认 ~/cu2cce-bridge，若在仓库内运行 make_cce 会生成
cu2cce-bridge/
.ninja_log
.ninja_deps

# 昇腾算子工程产物（cmake_cce / build.sh）
custom_opp_*.run
*.o.npu
tiling*.h

# 编辑器 / IDE
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Claude Code 本地会话配置（保留 settings.json 和 agents/commands，忽略本地权限文件）
.claude/settings.local.json
.claude/*.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 日志
*.log

# ============================================================
# 107002 排查后清理（2026-08-19）
# diag 探针在真机运行产生的中间产物/二进制；仓库内不落盘
# ============================================================


# ============================================================
# main 裁剪（2026-08-21，puresimt 主线）：新同构 B 实验产物归档到
# exp/new-homogeneous-v1 分支，main 不再跟踪以下目录（物理保留本地）
# ============================================================
tools/real_test/diag/

# 诊断探针运行时产物（tools/real_test/diag/ 下临时编译的二进制/宿主）
tools/real_test/diag/*.o
tools/real_test/diag/compose_*
tools/real_test/diag/acl_probe
tools/real_test/diag/acl_diff
tools/real_test/diag/echo
tools/real_test/diag/trunc_raw
tools/real_test/diag/minimal_echo

# kernel_convert / cucc 的中间 .cce（真机正常路径只写 /tmp；仓库内兜底忽略）
*.cce.tmp
*_conv.cce

# 服务器操作步骤清单（不再纳入版本库；结论沉淀在 docs/ 与 diag/README）
tools/real_test/SERVER_STEPS_*.txt

# 常见补丁/临时文件
*.orig
*.rej
*.bak
*.tmp

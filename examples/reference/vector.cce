// vector.cce —— 昇腾原生 SIMT VF 参考示例（用户实测，2026-08-19）
//
// 来源：用户现成能跑的例子（ccec 编译通过，`--cce-aicore-arch=dav-c310`）。
// 用途：cu2cce kernel_convert.py 的"转换目标形态"参照——用户写纯 CUDA
// （见 examples/vectorAdd/vectorAdd.cu、examples/minimal/minimal.cu），
// cucc 编译时自动转换成下面这种昇腾 SIMT VF 结构。
//
// 要点（真机验证）：
//   - 计算体放 __simt_vf__ 函数（threadIdx.x；warp 原语也只能在此上下文）
//   - kernel 入口 __global__[aicore]，内部 cce::async_invoke<VF> 启动
//   - 指针带 __gm__ 地址空间；half/half2 等类型来自 <__clang_cce_types.h>
//   - main 为空（本文件仅验证编译链路；真实运行见 examples/*.cu 经 cucc）
//
// 编译验证：ccec -std=gnu++17 -xcce --cce-aicore-arch=dav-c310 vector.cce

#include <__clang_cce_types.h>   // half2 类型定义

__simt_vf__ LAUNCH_BOUND(1024) [aicore] __attribute__((always_inline))
inline void simt_plus(__gm__ half2* a, __gm__ half2* b,
                      __gm__ half2* o, int n) {
    int tid = threadIdx.x;
    if (tid < n) {
        o[tid] = a[tid]--;
    }
}

__global__[aicore] void kernel_plus(__gm__ half2* a, __gm__ half2* b,
                                    __gm__ half2* o, int n)
{
    cce::async_invoke<simt_plus>(cce::dim3{256, 1, 1}, a, b, o, n);
}

int main(){
    return 0;
}

/*
 * puresimt_probe.asc —— puresimt 探针（.asc + -x asc --enable-simt 验证）。
 *
 * 纯 CUDA 写法（host 走 bridge 宏/wrapper，cuda* → wcuda* → aclrt*），详情见
 * ASCEND_RESEARCH_NOTES.md §2。kernel 用 CUDA 线程索引（threadIdx/blockIdx/
 * gridDim/blockDim 线性化），`<<<gridDim, blockDim, 255, stream>>>` 原生写法。
 * host 用 cudaStreamCreate 作为首调用，验证 bridge_init 初始化链
 * （aclInit→GetDeviceCount→SetDevice→CreateContext）。
 */
#include "cuda_runtime.h"
#include <stdio.h>

__global__ void kernel(int *a, int *b, int *c) {
    int tid = threadIdx.z * blockDim.y * blockDim.x
            + threadIdx.y * blockDim.x + threadIdx.x;
    int threadNum = blockDim.x * blockDim.y * blockDim.z;
    int blockid = blockIdx.z * gridDim.y * gridDim.x
                + blockIdx.y * gridDim.x + blockIdx.x;
    c[blockid * threadNum + tid] =
        a[blockid * threadNum + tid] + b[blockid * threadNum + tid];
}

int main(void) {
    int threadNum = 1024;
    int blockNum = 8;
    int count = threadNum * blockNum;
    size_t byteSize = count * sizeof(int);

    cudaStream_t stream = nullptr;
    cudaError_t err = cudaStreamCreate(&stream);
    if (err != cudaSuccess) {
        printf("cudaStreamCreate failed: %d\n", (int)err);
        return 1;
    }

    int *a = nullptr, *b = nullptr, *c = nullptr;
    cudaMallocHost((void **)&a, byteSize);
    cudaMallocHost((void **)&b, byteSize);
    cudaMallocHost((void **)&c, byteSize);
    for (int i = 0; i < count; i++) {
        a[i] = i;
        b[i] = 10;
    }

    int *d_a = nullptr, *d_b = nullptr, *d_c = nullptr;
    cudaMalloc((void **)&d_a, byteSize);
    cudaMalloc((void **)&d_b, byteSize);
    cudaMalloc((void **)&d_c, byteSize);
    cudaMemcpy(d_a, a, byteSize, cudaMemcpyHostToDevice);
    cudaMemcpy(d_b, b, byteSize, cudaMemcpyHostToDevice);
    cudaMemcpy(d_c, c, byteSize, cudaMemcpyHostToDevice);

    dim3 gridDim(2, 2, 2);
    dim3 blockDim(32, 16, 2);
    cudaLaunchKernel((const void *)kernel, gridDim, blockDim, nullptr, 255,
                     stream);
    cudaStreamSynchronize(stream);
    cudaMemcpy(c, d_c, byteSize, cudaMemcpyDeviceToHost);

    int bad = 0;
    for (int i = 0; i < count; i++) {
        if (c[i] != i + 10) {
            if (bad < 4) printf("c[%d]=%d expected=%d\n", i, c[i], i + 10);
            bad++;
        }
    }
    if (bad != 0) {
        printf("puresimt FAILED (%d mismatch)\n", bad);
        return 1;
    }
    printf("puresimt OK (count=%d)\n", count);

    cudaFree(d_a);
    cudaFree(d_b);
    cudaFree(d_c);
    cudaFreeHost(a);
    cudaFreeHost(b);
    cudaFreeHost(c);
    cudaStreamDestroy(stream);
    cudaDeviceReset();
    return 0;
}
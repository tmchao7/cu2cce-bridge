/* puresimt 探针（.asc 变体：导师说如果 .cce + -x dpp 不行，就用 .asc + -x asc --enable-simt） */
#include "acl/acl.h"
#include <stdio.h>

__global__ void kernel(int *a, int *b, int *c) {
    int tid = threadIdx.z * blockDim.y * blockDim.x
            + threadIdx.y * blockDim.x + threadIdx.x;
    int threadNum = blockDim.x * blockDim.y * blockDim.z;
    int blockid = blockIdx.z * gridDim.y * gridDim.x
                + blockIdx.y * gridDim.x + blockIdx.x;
    c[blockid * threadNum + tid] =
        a[blockid * threadNum + tid] + b[blockid * threadNum + tid];
}

int main(void) {
    int threadNum = 1024;
    int blockNum = 8;
    int count = threadNum * blockNum;
    size_t byteSize = count * sizeof(int);

    aclInit(nullptr);
    aclrtContext context = nullptr;
    int deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    int *a = nullptr, *b = nullptr, *c = nullptr;
    aclrtMallocHost((void **)&a, byteSize);
    aclrtMallocHost((void **)&b, byteSize);
    aclrtMallocHost((void **)&c, byteSize);
    for (int i = 0; i < count; i++) {
        a[i] = i;
        b[i] = 10;
    }

    int *d_a = nullptr, *d_b = nullptr, *d_c = nullptr;
    aclrtMalloc((void **)&d_a, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&d_b, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&d_c, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(d_a, byteSize, a, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(d_b, byteSize, b, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(d_c, byteSize, c, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    dim3 gridDim(2, 2, 2);
    dim3 blockDim(32, 16, 2);
    kernel<<<gridDim, blockDim, 255, stream>>>((int *)d_a, (int *)d_b,
                                               (int *)d_c);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(c, byteSize, d_c, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    int bad = 0;
    for (int i = 0; i < count; i++) {
        if (c[i] != i + 10) {
            if (bad < 4) printf("c[%d]=%d expected=%d\n", i, c[i], i + 10);
            bad++;
        }
    }
    if (bad != 0) {
        printf("puresimt FAILED (%d mismatch)\n", bad);
        return 1;
    }
    printf("puresimt OK (count=%d)\n", count);

    aclrtFree(d_a);
    aclrtFree(d_b);
    aclrtFree(d_c);
    aclrtFreeHost(a);
    aclrtFreeHost(b);
    aclrtFreeHost(c);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
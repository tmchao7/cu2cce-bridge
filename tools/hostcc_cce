#!/bin/bash
# ============================================================
# hostcc_cce —— host C/C++ compiler wrapper (cu-bridge bin/gnu parity).
#
# The virtual CUDA toolkit binds bin/{c++,g++,gcc,cc} to THIS script. All behavior
# is rule-driven from config/cu2cce_rules.json ("hostcc" section, consumed
# by tools/cu2cce_driver.py --hostcc-mode):
#   - pure compile (-c) / preprocess (-E) / query: passthrough to the real
#     system compiler untouched;
#   - link: exec the real compiler and append the rule-provided bridge
#     runtime + CANN libs (cu-bridge conf_gnu.json forces -lruntime_cu /
#     -lToolsExt_cu on every link — same shape, NPU libraries);
#   - device sources (.cu) are refused by the driver: they must go through
#     cucc.
#
# Degradation contract (kept local on purpose): without a usable bridge the
# script falls back to the plain system compiler instead of breaking builds.
# ============================================================
set -u

name="${CU2CCE_HOSTCC_NAME:-$(basename "$0")}"

CUCC_PATH="${CUCC_PATH:-}"
if [ -z "$CUCC_PATH" ] || [ ! -f "$CUCC_PATH/lib/libcce_bridge_runtime.so" ] || \
   [ ! -f "$CUCC_PATH/tools/cu2cce_driver.py" ]; then
    # Without a usable bridge, degrade to the plain system compiler.
    exec "/usr/bin/$name" "$@"
fi

exec python3 "$CUCC_PATH/tools/cu2cce_driver.py" \
    --hostcc-mode --hostcc-name "$name" -- "$@"

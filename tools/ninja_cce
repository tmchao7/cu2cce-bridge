#!/bin/bash
# ninja_cce —— run Ninja for a cu2cce-generated build tree.
#
# Two-phase protocol (cu-bridge ninja_maca parity): configure uses the mock
# nvcc entry, while this wrapper rebuilds the persistent CUDA-shaped shim with
# the real cucc before Ninja executes.  The same helper/lifecycle is used by
# make_cce and pre_cce so direct ninja and cmake_cce --build do not drift.
set -euo pipefail

CUCC_PATH="${CUCC_PATH:-}"
if [ -z "$CUCC_PATH" ] || [ ! -x "$CUCC_PATH/bin/cucc" ]; then
    echo "ninja_cce: CUCC_PATH must point to an installed cu2cce-bridge directory" >&2
    exit 1
fi
if ! command -v ninja >/dev/null 2>&1; then
    echo "ninja_cce: ninja executable not found" >&2
    exit 1
fi
if [ ! -f "$CUCC_PATH/tools/fake_toolkit_env.sh" ]; then
    echo "ninja_cce: shared helper missing: $CUCC_PATH/tools/fake_toolkit_env.sh" >&2
    exit 1
fi
CUCC_PATH="$(cd "$CUCC_PATH" && pwd -P)"
. "$CUCC_PATH/tools/fake_toolkit_env.sh"

ASCEND_TOOLKIT_HOME="${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}"
CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
CU2CCE_HOME="${CU2CCE_HOME:-${WCUDA_HOME:-${CUBRIDGE_HOME:-$HOME}}}"
CU2CCE_NPU_ARCH="$(cu2cce_resolve_npu_arch)" || exit 1
SHIM_ROOT="${CU2CCE_CMAKE_SHIM_DIR:-${CU2CCE_HOME:-${WCUDA_HOME:-${CUBRIDGE_HOME:-$HOME}}}/cu2cce-bridge/cmake-shim}"
if [[ "$SHIM_ROOT" != /* ]]; then
    # Ninja may receive -C <build>; resolve the shim before that directory
    # switch so it remains identical to the configure invocation.
    SHIM_ROOT="$PWD/$SHIM_ROOT"
fi
if [ "${CU2CCE_SHIM_ISOLATE:-0}" = "1" ]; then
    SHIM_ROOT="${SHIM_ROOT}-${PPID}"
fi

# The shared builder materializes $SHIM_ROOT/CUDA_DIR, matching cmake_cce's
# configure path. Repointing only a different lowercase directory would leave
# CMake's recorded compiler bound to mock_nvcc.
CUDA_DIR="$(cu2cce_prepare_fake_toolkit "$SHIM_ROOT" "$CUCC_PATH/bin/cucc" "$SHIM_ROOT/bin" wrapper)" || exit 1
printf 'ninja_cce: build phase: shim nvcc -> %s/bin/cucc\n' "$CUCC_PATH" >&2
if [ ! -e "$CUDA_DIR/bin/nvcc" ]; then
    echo "ninja_cce: fake toolkit build failed under $SHIM_ROOT" >&2
    exit 1
fi

export CUDA_PATH="$CUDA_DIR"
export CUDA_HOME="$CUDA_DIR"
export ASCEND_TOOLKIT_HOME
export CANN_BASE
export CU2CCE_NPU_ARCH="${CU2CCE_NPU_ARCH:-${CUCC_NPU_ARCH:-dav-c310-vec}}"
export CUCC_NPU_ARCH="$CU2CCE_NPU_ARCH"
export LD_LIBRARY_PATH="$CUCC_PATH/lib:$CANN_BASE/lib64:$CANN_BASE/runtime/lib64:${LD_LIBRARY_PATH:-}"
export PATH="$SHIM_ROOT/bin:$CUDA_DIR/bin:$CUCC_PATH/bin:$PATH"

for arg in "$@"; do
    case "$arg" in
        clean|*clean|clean-*)
            rm -rf "$SHIM_ROOT"
            break
            ;;
    esac
done

if [ "${WCUDA_DEBUG:-0}" = "1" ]; then
    echo "/* CUDA_PATH=$CUDA_PATH */" >&2
    echo "/* CU2CCE_NPU_ARCH=$CU2CCE_NPU_ARCH */" >&2
fi

exec ninja "$@"

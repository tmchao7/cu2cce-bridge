#!/bin/bash
# ninja_cce —— run Ninja for a cu2cce-generated build tree.
#
# Two-phase protocol (cu-bridge ninja_maca parity): when the build tree was
# configured through cmake_cce with a persistent shim, the shim nvcc is
# re-pointed at the real cucc for the build phase — configure answers via
# mock, build compiles via cucc. Direct `ninja` stays compatible: the mock
# keeps its configure-phase real-compile fallback.
set -euo pipefail

CUCC_PATH="${CUCC_PATH:-}"
if [ -z "$CUCC_PATH" ] || [ ! -x "$CUCC_PATH/bin/cucc" ]; then
    echo "ninja_cce: CUCC_PATH must point to an installed cu2cce-bridge directory" >&2
    exit 1
fi
if ! command -v ninja >/dev/null 2>&1; then
    echo "ninja_cce: ninja executable not found" >&2
    exit 1
fi

SHIM_ROOT="${CU2CCE_CMAKE_SHIM_DIR:-${CU2CCE_HOME:-${CUBRIDGE_HOME:-$HOME}}/cu2cce-bridge/cmake-shim}"
CUDA_DIR="$SHIM_ROOT/cuda"
if [ -e "$CUDA_DIR/bin/nvcc" ]; then
    ln -sfn "$CUCC_PATH/bin/cucc" "$CUDA_DIR/bin/nvcc"
    echo "ninja_cce: build phase: shim nvcc -> $CUCC_PATH/bin/cucc" >&2
fi

export PATH="$CUCC_PATH/bin:$PATH"
exec ninja "$@"

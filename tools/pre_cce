#!/bin/bash
# ============================================================
# pre_cce —— generic command wrapper (cu-bridge pre_makefile/pre_make parity).
#
# cu-bridge's documented use (FAQ Q5): autoconf-style `configure xxx`
# becomes `pre_makefile configure xxx`. pre_cce does the same for NPU:
# it prepares the fake CUDA toolkit environment (bin/nvcc -> cucc,
# CUDA-named lib64 links, host compiler entries) and then evals the
# wrapped command, so scripts that probe for nvcc/gcc during configuration
# see a complete toolchain. The sentinel/build logic lives in the shared
# helper tools/fake_toolkit_env.sh (config/shim_layout.json manifest).
#
# Host compiler entries use the hostcc_cce wrapper (same as make_cce /
# cmake_cce — links automatically carry the bridge runtime + CANN libs);
# identity /usr/bin links are the fallback. Previously this wrapper used
# identity links only, so autotools projects linking with plain g++ missed
# the runtime injection.
#
# Usage:
#   pre_cce ./configure --prefix=/opt/app
#   pre_cce make -j8
#   pre_cce cmake -S . -B build      # for scripts that invoke cmake internally
# ============================================================
set -u

setup_debug_propagation() {
    [[ $- == *x* ]] && export BASH_XTRACE=1
    [[ $- == *v* ]] && export BASH_VERBOSE=1
    [[ $- == *e* ]] && export BASH_ERREXIT=1
}
setup_debug_propagation

ASCEND_TOOLKIT_HOME=${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}
CUCC_PATH=${CUCC_PATH:-}
CU2CCE_HOME=${CU2CCE_HOME:-${CUBRIDGE_HOME:-$HOME}}

if [ -z "${CUCC_PATH}" ]; then
    echo "pre_cce: CUCC_PATH not set (point to cu2cce-bridge install dir)" >&2
    exit 1
fi
if [ "$#" -eq 0 ]; then
    echo "pre_cce: no command to wrap (usage: pre_cce <command> [args...])" >&2
    exit 1
fi
if [ ! -f "${CUCC_PATH}/tools/fake_toolkit_env.sh" ]; then
    echo "pre_cce: shared helper missing: ${CUCC_PATH}/tools/fake_toolkit_env.sh" >&2
    exit 1
fi
. "${CUCC_PATH}/tools/fake_toolkit_env.sh"

TEMP_DIR_NAME="cu2cce-bridge"
DST_WCUDA="$CU2CCE_HOME/${TEMP_DIR_NAME}"
# Parallel-job isolation (cu-bridge USE_WCUDA_FOR_MULTI_JOB parity).
if [ "${CU2CCE_SHIM_ISOLATE:-0}" = "1" ]; then
    DST_WCUDA="${DST_WCUDA}-${PPID}"
fi

CUDA_DIR="$(cu2cce_prepare_fake_toolkit "$DST_WCUDA" "$CUCC_PATH/bin/cucc" "$DST_WCUDA/bin" wrapper)" || exit 1

export CUDA_PATH="$CUDA_DIR"
export PATH="$DST_WCUDA/bin:$CUDA_DIR/bin:$PATH"
export ASCEND_TOOLKIT_HOME
export CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
export CU2CCE_NPU_ARCH="${CU2CCE_NPU_ARCH:-$(bash "${CUCC_PATH}/tools/device_arch.sh" 2>/dev/null || echo dav-c310-vec)}"
export LD_LIBRARY_PATH="${CUCC_PATH}/lib:${CANN_BASE}/lib64:${LD_LIBRARY_PATH:-}"

# clean 目标词元匹配（与 make_cce 相同：按目标名而非整串子串）。
for arg in "$@"; do
    case "$arg" in
        clean|*clean|clean-*)
            rm -rf "$DST_WCUDA"
            break
            ;;
    esac
done

# quote-safe eval of the wrapped command (mirrors pre_makefile's escaping)
eval "$*"

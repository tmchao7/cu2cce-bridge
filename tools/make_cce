#!/bin/bash
# ============================================================
# make_cce —— 包 make，拦截 nvcc → cucc（昇腾版）
#
# 仿照 cu-bridge 的 tools/make_maca（Apache-2.0）：
#   - 建立临时"伪 CUDA 目录"：把 cu2cce-bridge 的 include/bin 软链成
#     CUDA_TOOLKIT 布局（bin/nvcc → cucc），这样 Makefile 里
#     用 `nvcc`/`$(CUDA_PATH)/bin/nvcc` 的地方都被 cucc 接管
#   - 设 CUDA_PATH / PATH，然后调用原 make
#
# 用法：make_cce [-jN] [target...]   （等价 make，但 nvcc 被拦截）
#
# ⚠️ 需要在安装 CANN 的 Linux/Ascend 环境中执行。真机环境变量见方案文档 §6。
# ============================================================
set -u

setup_debug_propagation() {
    [[ $- == *x* ]] && export BASH_XTRACE=1
    [[ $- == *v* ]] && export BASH_VERBOSE=1
    [[ $- == *e* ]] && export BASH_ERREXIT=1
}
setup_debug_propagation

# ---------------- 环境 ----------------
ASCEND_TOOLKIT_HOME=${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}
CUCC_PATH=${CUCC_PATH:-}
# Keep the old CUBRIDGE_HOME name as a compatibility alias, but use the
# cu2cce-specific name for new projects.
CU2CCE_HOME=${CU2CCE_HOME:-${CUBRIDGE_HOME:-$HOME}}

if [ -z "${CUCC_PATH}" ]; then
    echo "make_cce: CUCC_PATH not set (point to cu2cce-bridge install dir)" >&2
    exit 1
fi

TEMP_DIR_NAME="cu2cce-bridge"
DST_WCUDA="$CU2CCE_HOME/${TEMP_DIR_NAME}"

# 若上一次残留且没有 make.log，清理（仿照 make_maca 的容错）
if [ ! -f "$DST_WCUDA/make.log" ]; then
    rm -rf "$DST_WCUDA"
fi
mkdir -p "$DST_WCUDA"

# ---------------- 建伪 CUDA 目录 ----------------
# CUDA_PATH 指向伪目录（其 bin/nvcc → cucc）
CUDA_DIR="$DST_WCUDA/CUDA_DIR"
mkdir -p "$CUDA_DIR/bin"
mkdir -p "$CUDA_DIR/include"
mkdir -p "$CUDA_DIR/lib64/stubs"

# targets 三元组按宿主派生（与 cmake_cce 的 HOST_TRIPLE 规则一致，
# 对应 make_maca 的 targets/$(uname -m)-$(uname -s | tr A-Z a-z) 布局）
HOST_ARCH="$(uname -m 2>/dev/null || echo x86_64)"
case "$HOST_ARCH" in amd64) HOST_ARCH=x86_64 ;; arm64) HOST_ARCH=aarch64 ;; esac
HOST_OS="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' || echo linux)"
case "$HOST_OS" in darwin) HOST_OS=darwin ;; linux) HOST_OS=linux ;; esac
HOST_TRIPLE="${HOST_ARCH}-${HOST_OS}"
mkdir -p "$CUDA_DIR/targets/$HOST_TRIPLE"

# bin/nvcc → cucc
ln -sf "${CUCC_PATH}/bin/cucc" "$CUDA_DIR/bin/nvcc"
ln -sf "${CUCC_PATH}/bin/cucc" "$CUDA_DIR/bin/cucc"

# include：软链 cu2cce 的整个 include（含 cuda_runtime.h 等 + bridge/）
ln -sfn "${CUCC_PATH}/include" "$CUDA_DIR/include" 2>/dev/null || true
# 若上面整目录软链不生效（如跨文件系统），退化为逐项软链
ln -sfn "$CUDA_DIR/include" "$CUDA_DIR/targets/$HOST_TRIPLE/include"
ln -sfn "$CUDA_DIR/lib64" "$CUDA_DIR/targets/$HOST_TRIPLE/lib"
if [ ! -e "$CUDA_DIR/include/cuda_runtime.h" ]; then
    for f in "${CUCC_PATH}/include"/*; do
        ln -sfn "$f" "$CUDA_DIR/include/$(basename "$f")"
    done
fi

# 若 make 里用了 lib64（昇腾一般用 ASCEND_TOOLKIT_HOME/lib64），补一个
mkdir -p "$CUDA_DIR/lib64"

# CUDA 命名的运行时库软链（对齐 cu-bridge tools/link.json 的 pre_make 段：
# "lib64/libcudart.so" -> runtime 库）。经 cucc 编译的对象只含 wcuda* 符号，
# 纯 g++ 链接 Make 工程的 -lcudart/-lcuda 在此解析到桥运行时即可。
for _cuda_lib in libcudart.so libcudart_static.a libcudadevrt.a libcuda.so libcuda.so.1; do
    ln -sfn "${CUCC_PATH}/lib/libcce_bridge_runtime.so" "$CUDA_DIR/lib64/$_cuda_lib"
    ln -sfn "${CUCC_PATH}/lib/libcce_bridge_runtime.so" "$CUDA_DIR/lib64/stubs/$_cuda_lib"
done
unset _cuda_lib

# ---------------- 设环境并调 make ----------------
export CUDA_PATH="$CUDA_DIR"
export PATH="$CUDA_DIR/bin:$PATH"
# 让 bisheng 能找到 ACL 头/库
export ASCEND_TOOLKIT_HOME
export CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
export CU2CCE_NPU_ARCH="${CU2CCE_NPU_ARCH:-${CUCC_NPU_ARCH:-dav-c310-vec}}"

# -x cce 由 cucc 识别（cucc 已内置）
# debug_echo
if [ "${WCUDA_DEBUG:-0}" == "1" ]; then
    echo "/* CUDA_PATH=$CUDA_PATH */"
    echo "/* PATH=$PATH */"
fi

if [[ "$*" == *"clean"* ]]; then
    rm -rf "$DST_WCUDA"
fi

exec make "$@"

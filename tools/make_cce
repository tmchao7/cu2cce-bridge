#!/bin/bash
# ============================================================
# make_cce —— 包 make，拦截 nvcc → cucc（昇腾版）
#
# 仿照 cu-bridge 的 tools/make_maca（Apache-2.0）：
#   - 建立临时"伪 CUDA 目录"：把 cu2cce-bridge 的 include/bin 软链成
#     CUDA_TOOLKIT 布局（bin/nvcc → cucc），这样 Makefile 里
#     用 `nvcc`/`$(CUDA_PATH)/bin/nvcc` 的地方都被 cucc 接管。
#     哨兵/布局构建逻辑在共享库 tools/fake_toolkit_env.sh 中
#     （清单 config/shim_layout.json，link.json parity），与
#     cmake_cce/pre_cce 共用一份实现。
#   - 设 CUDA_PATH / PATH，然后调用原 make
#
# 用法：make_cce [-jN] [target...]   （等价 make，但 nvcc 被拦截）
#
# ⚠️ 需要在安装 CANN 的 Linux/Ascend 环境中执行。真机环境变量见方案文档 §6。
# ============================================================
set -u

setup_debug_propagation() {
    [[ $- == *x* ]] && export BASH_XTRACE=1
    [[ $- == *v* ]] && export BASH_VERBOSE=1
    [[ $- == *e* ]] && export BASH_ERREXIT=1
}
setup_debug_propagation

# ---------------- 环境 ----------------
ASCEND_TOOLKIT_HOME=${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}
CUCC_PATH=${CUCC_PATH:-}
# Keep the old CUBRIDGE_HOME name as a compatibility alias, but use the
# cu2cce-specific name for new projects.
CU2CCE_HOME=${CU2CCE_HOME:-${CUBRIDGE_HOME:-$HOME}}
if [ -z "${CUCC_PATH}" ]; then
    echo "make_cce: CUCC_PATH not set (point to cu2cce-bridge install dir)" >&2
    exit 1
fi
if [ ! -f "${CUCC_PATH}/tools/fake_toolkit_env.sh" ]; then
    echo "make_cce: shared helper missing: ${CUCC_PATH}/tools/fake_toolkit_env.sh" >&2
    exit 1
fi
. "${CUCC_PATH}/tools/fake_toolkit_env.sh"
CU2CCE_NPU_ARCH="$(cu2cce_resolve_npu_arch)" || exit 1

TEMP_DIR_NAME="cu2cce-bridge"
DST_WCUDA="$CU2CCE_HOME/${TEMP_DIR_NAME}"
# Parallel-job isolation (cu-bridge USE_WCUDA_FOR_MULTI_JOB parity): each
# top-level make_cce job gets its own fake toolkit when requested.
if [ "${CU2CCE_SHIM_ISOLATE:-0}" = "1" ]; then
    DST_WCUDA="${DST_WCUDA}-${PPID}"
fi

# ---------------- 建伪 CUDA 目录 ----------------
# CUDA_PATH 指向伪目录（其 bin/nvcc → cucc）；哨兵、布局构建（lib64 CUDA 名
# 软链族、targets 三元组、extras/CUPTI、宿主编译器条目）在共享 helper 里。
CUDA_DIR="$(cu2cce_prepare_fake_toolkit "$DST_WCUDA" "$CUCC_PATH/bin/cucc" "$DST_WCUDA/bin" wrapper)" || exit 1

# ---------------- 设环境并调 make ----------------
export CUDA_PATH="$CUDA_DIR"
export PATH="$DST_WCUDA/bin:$CUDA_DIR/bin:$PATH"
# 让 bisheng 能找到 ACL 头/库
export ASCEND_TOOLKIT_HOME
export CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
export CU2CCE_NPU_ARCH="${CU2CCE_NPU_ARCH:-${CUCC_NPU_ARCH:-dav-c310-vec}}"

# -x cce 由 cucc 识别（cucc 已内置）
# debug_echo
if [ "${WCUDA_DEBUG:-0}" == "1" ]; then
    echo "/* CUDA_PATH=$CUDA_PATH */"
    echo "/* PATH=$PATH */"
fi

# clean 目标词元匹配（对齐 make_maca 的"clean 时删伪目录"，但按目标名而非
# 整串子串匹配：`make cleanpack` 这类恰好含 clean 子串的普通目标不误删）。
for arg in "$@"; do
    case "$arg" in
        clean|*clean|clean-*)
            rm -rf "$DST_WCUDA"
            break
            ;;
    esac
done

exec make "$@"

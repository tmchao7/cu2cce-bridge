#!/bin/bash
# cmake_cce —— configure a CUDA CMake project through cucc/ccec.
#
# Usage:
#   export CUCC_PATH=/path/to/cu2cce-bridge/install
#   cmake_cce -S . -B build
#   cmake_cce --build build            # dispatches to make_cce/ninja_cce
#   cmake --build build                # also works via the persistent shim
#
# The wrapper creates a CUDA-toolkit-shaped shim for CMake's compiler
# detection (layout manifest: config/shim_layout.json, built by
# tools/build_shim_tree.py — cu-bridge link.json/stub_link.json parity).
# Set CU2CCE_CMAKE_SHIM_DIR to keep it outside /tmp and make the configured
# compiler path persistent across reboots or /tmp cleanup.

set -euo pipefail

CUCC_PATH="${CUCC_PATH:-}"
CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
ASCEND_TOOLKIT_HOME="${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}"

# Match cu-bridge's query passthrough: informational cmake invocations must
# work on a development host before an Ascend/CANN install is available.
for arg in "$@"; do
    case "$arg" in
        --version|-version|/V|-E|--help*) exec cmake "$@";;
    esac
done

if [ -z "$CUCC_PATH" ] || [ ! -x "$CUCC_PATH/bin/cucc" ]; then
    echo "cmake_cce: CUCC_PATH must point to an installed cu2cce-bridge directory" >&2
    echo "cmake_cce: expected $CUCC_PATH/bin/cucc" >&2
    exit 1
fi
if [ ! -f "${CUCC_PATH}/tools/fake_toolkit_env.sh" ]; then
    echo "cmake_cce: shared helper missing: ${CUCC_PATH}/tools/fake_toolkit_env.sh" >&2
    exit 1
fi
# Resolve paths before sourcing/building the shim; build dispatch later changes
# directory, so relative installation paths must not leak into the environment.
CUCC_PATH="$(cd "$CUCC_PATH" && pwd -P)"
. "${CUCC_PATH}/tools/fake_toolkit_env.sh"
if ! CCEC_PATH="$(cu2cce_resolve_ccec)"; then
    echo "cmake_cce: ccec not found; set CCEC_PATH or provide CANN_BASE/ASCEND_TOOLKIT_HOME" >&2
    exit 1
fi
export CCEC_PATH
CU2CCE_NPU_ARCH="$(cu2cce_resolve_npu_arch)" || exit 1

# Detect build/configure mode and the build directory before selecting the
# shim. The same stable build key is recomputed by cmake_cce --build and
# ninja_cce, while an explicit CU2CCE_CMAKE_SHIM_DIR always wins.
build_phase=0
build_dir_hint=""
args=("$@")
count=${#args[@]}
index=0
while [ "$index" -lt "$count" ]; do
    arg="${args[$index]}"
    case "$arg" in
        --build=*)
            build_phase=1
            build_dir_hint="${arg#--build=}"
            ;;
        --build)
            build_phase=1
            index=$((index + 1))
            if [ "$index" -lt "$count" ]; then build_dir_hint="${args[$index]}"; fi
            ;;
        --install|--install=*) build_phase=1 ;;
        -B=*)
            [ "$build_phase" -eq 0 ] && build_dir_hint="${arg#-B=}"
            ;;
        -B)
            if [ "$build_phase" -eq 0 ]; then
                index=$((index + 1))
                if [ "$index" -lt "$count" ]; then build_dir_hint="${args[$index]}"; fi
            fi
            ;;
        -B*)
            [ "$build_phase" -eq 0 ] && build_dir_hint="${arg#-B}"
            ;;
    esac
    index=$((index + 1))
done
if [ "$build_phase" -eq 0 ] && [ -z "$build_dir_hint" ]; then
    build_dir_hint="$PWD"
fi
if [ "$build_phase" -eq 1 ] && [ -z "$build_dir_hint" ] && [[ "$*" == *--build* ]]; then
    echo "cmake_cce: --build requires a build directory" >&2
    exit 1
fi

# Shim directory resolution + two-phase protocol. The default is now keyed by
# build directory rather than globally shared, preventing cross-project
# overwrite while preserving the explicit legacy fallback string.
if [ -n "${CU2CCE_CMAKE_SHIM_DIR:-}" ]; then
    SHIM_ROOT="$CU2CCE_CMAKE_SHIM_DIR"
elif [ "$build_phase" -eq 1 ] && [ -n "$build_dir_hint" ] && \
    SHIM_ROOT="$(cu2cce_cmake_cache_shim_root "$build_dir_hint" 2>/dev/null)"; then
    # Preserve the path recorded by an older or explicitly configured CMake
    # tree; the build still repoints that shim to this cucc installation.
    :
else
    SHIM_BASE="${CU2CCE_HOME:-${WCUDA_HOME:-${CUBRIDGE_HOME:-$HOME}}}/cu2cce-bridge"
    SHIM_ROOT="$(cu2cce_shim_root_for_build "$SHIM_BASE" "$build_dir_hint")" || {
        echo "cmake_cce: cannot derive stable shim root for build directory $build_dir_hint" >&2
        exit 1
    }
fi
# Keep a relative user-provided shim path stable across the build-phase cd.
if [[ "$SHIM_ROOT" != /* ]]; then
    SHIM_ROOT="$PWD/$SHIM_ROOT"
fi
# Explicit build-directory scoping already provides cross-process isolation;
# retain the PPID suffix for invocations without a build directory.
if [ "${CU2CCE_SHIM_ISOLATE:-0}" = "1" ] && [ -z "${CU2CCE_CMAKE_SHIM_DIR:-}" ] && [ "$build_dir_hint" = "$PWD" ]; then
    SHIM_ROOT="${SHIM_ROOT}-${PPID}"
fi
# Pass the resolved root to the generator wrapper so Make/Ninja rebuild the
# same shim that CMake used during configure, including custom roots.
export CU2CCE_CMAKE_SHIM_DIR="$SHIM_ROOT"
CUDA_DIR="$SHIM_ROOT/CUDA_DIR"
if [ "$build_phase" -eq 1 ]; then
    if [ -e "$CUDA_DIR/bin/nvcc" ]; then
        ln -sfn "$CUCC_PATH/bin/cucc" "$CUDA_DIR/bin/nvcc"
        printf 'cmake_cce: build phase: shim nvcc -> %s/bin/cucc\n' "$CUCC_PATH" >&2
    else
        printf 'cmake_cce: build phase: no shim from a configure run at %s; continuing\n' "$CUDA_DIR" >&2
    fi
    # deal_build_param parity (cu-bridge cmake_mock:64-131): route the build
    # through make_cce/ninja_cce so Make/Ninja get the same environment
    # preparation (ASCEND vars, device arch, PATH) as direct make_cce runs.
    # cmake --build remains the fallback for odd argument shapes.
    build_dir="${build_dir_hint:-}"
    build_target=()
    build_jobs=()
    build_unbounded_parallel=0
    build_verbose=0
    build_config=""
    clean_first=0
    transfer_params=()
    args=("$@")
    count=${#args[@]}
    index=0
    while [ "$index" -lt "$count" ]; do
        arg="${args[$index]}"
        case "$arg" in
            --build=*)
                build_dir="${arg#--build=}"
                ;;
            --build)
                index=$((index + 1))
                if [ "$index" -ge "$count" ]; then
                    echo "cmake_cce: --build requires a build directory" >&2
                    exit 1
                fi
                build_dir="${args[$index]}"
                ;;
            --target=*|-t=*)
                target_value="${arg#*=}"
                if [ -n "$target_value" ]; then build_target+=("$target_value"); fi
                ;;
            --target|-t)
                while [ $((index + 1)) -lt "$count" ]; do
                    next="${args[$((index + 1))]}"
                    case "$next" in -*) break ;; esac
                    build_target+=("$next")
                    index=$((index + 1))
                done
                ;;
            --parallel=*)
                build_jobs+=("-j" "${arg#*=}")
                ;;
            -j[0-9]*)
                build_jobs+=("-j" "${arg#-j}")
                ;;
            -j=*)
                build_jobs+=("-j" "${arg#-j=}")
                ;;
            --parallel|-j)
                next="${args[$((index + 1))]:-}"
                case "$next" in
                    ''|[-+]*) build_unbounded_parallel=1 ;;
                    *) build_jobs+=("-j" "$next"); index=$((index + 1)) ;;
                esac
                ;;
            --config=*)
                build_config="${arg#--config=}"
                [ -n "$build_config" ] || { echo "cmake_cce: --config requires a value" >&2; exit 1; }
                ;;
            --config)
                index=$((index + 1))
                if [ "$index" -ge "$count" ]; then
                    echo "cmake_cce: --config requires a value" >&2
                    exit 1
                fi
                build_config="${args[$index]}"
                case "$build_config" in -*) echo "cmake_cce: --config requires a value" >&2; exit 1 ;; esac
                ;;
            --clean-first)
                clean_first=1
                ;;
            --verbose|-v)
                build_verbose=1
                ;;
            --)
                while [ $((index + 1)) -lt "$count" ]; do
                    index=$((index + 1))
                    transfer_params+=("${args[$index]}")
                done
                ;;
            *)
                : # unknown tokens after --build <dir> are ignored (reference parity)
                ;;
        esac
        index=$((index + 1))
    done
    if [ -n "$build_dir" ]; then
        if [ ! -d "$build_dir" ]; then
            echo "cmake_cce: build directory not found: $build_dir" >&2
            exit 1
        fi
        if [ -f "$build_dir/build.ninja" ]; then
            generator_tool="ninja_cce"
        else
            generator_tool="make_cce"
        fi
        if [ "$build_unbounded_parallel" -eq 1 ]; then
            if [ "$generator_tool" = "ninja_cce" ]; then
                # Ninja requires an explicit value; 0 means unlimited, which
                # is the equivalent of Make's bare -j and CMake's
                # --parallel-without-a-value semantics.
                build_jobs+=("-j" "0")
            else
                build_jobs+=("-j")
            fi
        fi
        if [ "$build_verbose" -eq 1 ]; then
            if [ "$generator_tool" = "ninja_cce" ]; then
                build_jobs+=("-v")
            else
                build_jobs+=("VERBOSE=1")
            fi
        fi
        tool_path="$CUCC_PATH/bin/$generator_tool"
        [ -x "$tool_path" ] || tool_path="$CUCC_PATH/tools/$generator_tool"
        if [ ! -x "$tool_path" ]; then
            echo "cmake_cce: $generator_tool not found under $CUCC_PATH; falling back to cmake --build" >&2
            exec cmake "$@"
        fi
        generator_args=()
        if [ "$generator_tool" = "ninja_cce" ] && [ -n "$build_config" ] && \
            [ -f "$build_dir/build-${build_config}.ninja" ]; then
            generator_args+=("-f" "build-${build_config}.ninja")
        fi
        if [ "${#build_jobs[@]}" -gt 0 ]; then
            generator_args+=("${build_jobs[@]}")
        fi
        if [ "${#build_target[@]}" -gt 0 ]; then
            generator_args+=("${build_target[@]}")
        fi
        if [ "${#transfer_params[@]}" -gt 0 ]; then
            generator_args+=("${transfer_params[@]}")
        fi
        printf 'cmake_cce: dispatching --build %s -> %s\n' "$build_dir" "$tool_path" >&2
        cd "$build_dir"
        if [ "$clean_first" -eq 1 ]; then
            if [ "$generator_tool" = "ninja_cce" ]; then
                "$tool_path" -t clean
            else
                "$tool_path" clean
            fi
        fi
        exec "$tool_path" "${generator_args[@]}"
    fi
    exec cmake "$@"
fi

HOST_TRIPLE="$(cu2cce_host_triple)"

# Build the toolkit-shaped shim through the shared helper (sentinel +
# build_shim_tree.py over config/shim_layout.json — cu-bridge
# stub_link.json parity). Configure phase binds the shim nvcc to the mock;
# the build phase re-points it to cucc above.
CUDA_DIR="$(cu2cce_prepare_fake_toolkit "$SHIM_ROOT" "$CUCC_PATH/tools/nvcc_entry.sh" "$CUDA_DIR/bin" wrapper)" || exit 1

printf 'cmake_cce: CUDA shim: %s\n' "$CUDA_DIR" >&2
printf 'cmake_cce: host toolkit layout: %s\n' "$HOST_TRIPLE" >&2
printf 'cmake_cce: Ascend architecture: %s\n' "$CU2CCE_NPU_ARCH" >&2

export CUCC_PATH
export CUDA_PATH="$CUDA_DIR"
export CUDA_HOME="$CUDA_DIR"
export CANN_BASE
export ASCEND_TOOLKIT_HOME
export CU2CCE_NPU_ARCH
export CUCC_NPU_ARCH="$CU2CCE_NPU_ARCH"
export PATH="$CUCC_PATH/bin:$CUDA_DIR/bin:$PATH"
export CU2CCE_HOST_TRIPLE="$HOST_TRIPLE"
export LD_LIBRARY_PATH="$(cu2cce_prepend_ld_library_path \
    "$CUCC_PATH/lib:$CANN_BASE/lib64:$CANN_BASE/runtime/lib64")"

args=("$@")
have_arch=0
have_module_path=0
have_runtime=0
have_override=0
for index in "${!args[@]}"; do
    arg="${args[$index]}"
    case "$arg" in
        -DCMAKE_CUDA_ARCHITECTURES=*|-DCMAKE_CUDA_ARCHITECTURES) have_arch=1;;
        -DCMAKE_CUDA_RUNTIME_LIBRARY=*) have_runtime=1;;
        -DCMAKE_CUDA_RUNTIME_LIBRARY) have_runtime=1;;
        -DCMAKE_USER_MAKE_RULES_OVERRIDE*|-DCMAKE_USER_MAKE_RULES_OVERRIDE_CUDA*) have_override=1;;
        -DCMAKE_MODULE_PATH=*)
            have_module_path=1
            user_module_path="${arg#-DCMAKE_MODULE_PATH=}"
            if [ -n "$user_module_path" ]; then
                args[$index]="-DCMAKE_MODULE_PATH=$CUCC_PATH/cmake_modules;$user_module_path"
            else
                args[$index]="-DCMAKE_MODULE_PATH=$CUCC_PATH/cmake_modules"
            fi
            ;;
        -DCMAKE_MODULE_PATH) have_module_path=1;;
    esac
done
if [ "$have_arch" -eq 0 ]; then
    # CMake's generated -gencode flags describe NVIDIA GPUs. ccec selects the
    # Ascend target through CU2CCE_NPU_ARCH instead.
    args+=("-DCMAKE_CUDA_ARCHITECTURES=OFF")
fi
if [ "$have_runtime" -eq 0 ]; then
    # CMake otherwise injects -lcudadevrt/-lcudart_static into host targets
    # that link a CUDA library. Those NVIDIA runtime libraries do not exist on
    # Ascend; CUDA::cudart is provided explicitly by FindCUDAToolkit.cmake.
    args+=("-DCMAKE_CUDA_RUNTIME_LIBRARY=None")
fi
if [ "$have_module_path" -eq 0 ]; then
    args+=("-DCMAKE_MODULE_PATH=$CUCC_PATH/cmake_modules")
fi
args+=("-DCMAKE_CUDA_COMPILER=$CUDA_DIR/bin/nvcc")

# CMake-user-make-rules override: deterministically pin the CUDA compiler
# identity before CMake's stock detection runs. Disable with
# CU2CCE_CMAKE_NO_OVERRIDE=1 to fall back to the pure -DCMAKE_CUDA_* +
# module-path path.
if [ "${CU2CCE_CMAKE_NO_OVERRIDE:-0}" != "1" ] && [ "$have_override" -eq 0 ]; then
    if [ -f "$CUCC_PATH/cmake_modules/override/CUDAOverrides.cmake" ]; then
        args+=("-DCMAKE_USER_MAKE_RULES_OVERRIDE=$CUCC_PATH/cmake_modules/override/CUDAOverrides.cmake")
        args+=("-DCMAKE_USER_MAKE_RULES_OVERRIDE_CUDA=$CUCC_PATH/cmake_modules/override/CUDAOverrides.cmake")
    else
        echo "cmake_cce: override module missing; continuing without override" >&2
    fi
fi

if [ "${CU2CCE_CMAKE_DEBUG:-0}" = "1" ]; then
    printf 'cmake_cce: configure command:' >&2
    printf ' %q' cmake "${args[@]}" >&2
    printf '\n' >&2
fi

exec cmake "${args[@]}"

#!/bin/bash
# cmake_cce —— configure a CUDA CMake project through cucc/ccec.
#
# Usage:
#   export CUCC_PATH=/path/to/cu2cce-bridge/install
#   cmake_cce -S . -B build
#   cmake --build build
#
# The wrapper creates a CUDA-toolkit-shaped shim for CMake's compiler
# detection. Set CU2CCE_CMAKE_SHIM_DIR to keep it outside /tmp and make the
# configured compiler path persistent across reboots or /tmp cleanup.

set -euo pipefail

CUCC_PATH="${CUCC_PATH:-}"
CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
ASCEND_TOOLKIT_HOME="${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}"
# Device architecture resolution (cu-bridge multi_target.sh parity):
# env -> device query/cache -> default; see tools/device_arch.sh.
if [ -z "${CU2CCE_NPU_ARCH:-}" ] && [ -z "${CUCC_NPU_ARCH:-}" ]; then
    CU2CCE_NPU_ARCH="$(bash "${CUCC_PATH}/tools/device_arch.sh" 2>/dev/null || echo dav-c310-vec)"
else
    CU2CCE_NPU_ARCH="${CU2CCE_NPU_ARCH:-${CUCC_NPU_ARCH:-dav-c310-vec}}"
fi

if [ -z "$CUCC_PATH" ] || [ ! -x "$CUCC_PATH/bin/cucc" ]; then
    echo "cmake_cce: CUCC_PATH must point to an installed cu2cce-bridge directory" >&2
    echo "cmake_cce: expected $CUCC_PATH/bin/cucc" >&2
    exit 1
fi
if [ ! -x "$CANN_BASE/bin/ccec" ]; then
    echo "cmake_cce: ccec not found at $CANN_BASE/bin/ccec" >&2
    exit 1
fi

for arg in "$@"; do
    case "$arg" in
        --version|-version|/V|-E|--help*) exec cmake "$@";;
    esac
done

# Shim directory resolution + two-phase protocol. The DEFAULT shim root is
# persistent under the user's home — same semantics as cu-bridge's
# CUBRIDGE_HOME ($HOME/cu-bridge): the two-phase protocol (configure via
# mock, build via real cucc) requires configure and build to share one shim,
# and build.make records the configured compiler path.
if [ -n "${CU2CCE_CMAKE_SHIM_DIR:-}" ]; then
    SHIM_ROOT="$CU2CCE_CMAKE_SHIM_DIR"
else
    SHIM_ROOT="${CU2CCE_HOME:-${CUBRIDGE_HOME:-$HOME}}/cu2cce-bridge/cmake-shim"
fi
CUDA_DIR="$SHIM_ROOT/cuda"

# Build/install phase: re-point the shim nvcc at the real cucc (cu-bridge's
# make_maca rebuilds CUDA_DIR the same way), then hand over to cmake.
build_phase=0
for arg in "$@"; do
    case "$arg" in
        --build|--install) build_phase=1 ;;
    esac
done
if [ "$build_phase" -eq 1 ]; then
    if [ -e "$CUDA_DIR/bin/nvcc" ]; then
        ln -sfn "$CUCC_PATH/bin/cucc" "$CUDA_DIR/bin/nvcc"
        printf 'cmake_cce: build phase: shim nvcc -> %s/bin/cucc\n' "$CUCC_PATH" >&2
    else
        printf 'cmake_cce: build phase: no shim from a configure run at %s; continuing\n' "$CUDA_DIR" >&2
    fi
    exec cmake "$@"
fi

HOST_ARCH="$(uname -m 2>/dev/null || echo x86_64)"
case "$HOST_ARCH" in
    amd64) HOST_ARCH=x86_64 ;;
    arm64) HOST_ARCH=aarch64 ;;
esac
HOST_OS="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' || echo linux)"
case "$HOST_OS" in
    darwin) HOST_OS=darwin ;;
    linux) HOST_OS=linux ;;
esac
HOST_TRIPLE="${HOST_ARCH}-${HOST_OS}"

mkdir -p \
    "$CUDA_DIR/bin" \
    "$CUDA_DIR/lib64/stubs" \
    "$CUDA_DIR/nvvm/libdevice" \
    "$CUDA_DIR/lib64/cmake/CUDAToolkit" \
    "$CUDA_DIR/targets/$HOST_TRIPLE" \
    "$CUDA_DIR/extras/CUPTI/include" \
    "$CUDA_DIR/extras/CUPTI/lib64"

# Recreate the include link as a single directory link so all installed CUDA
# compatibility headers are visible to projects that use toolkit-relative
# paths. Do not copy or rewrite user source files.
rm -rf "$CUDA_DIR/include"
ln -s "$CUCC_PATH/include" "$CUDA_DIR/include"
# Configure phase: the shim nvcc goes through the probe-answering mock.
# Re-pointing here makes repeated configure/build cycles on one persistent
# shim deterministic (build phase re-points it to real cucc, see above).
ln -sfn "$CUCC_PATH/tools/nvcc_entry.sh" "$CUDA_DIR/bin/nvcc"
# Host compilers as toolkit-relative entries (mirrors cu-bridge's
# link.json pre_cmake section): prefer the hostcc wrapper (adds the bridge
# runtime on links, passthrough on compiles — bin/gnu parity), falling back
# to identity symlinks when the wrapper is unavailable.
for _host_cc in c++ g++ gcc cc; do
    if [ -x "$CUCC_PATH/tools/hostcc_cce" ]; then
        ln -sfn "$CUCC_PATH/tools/hostcc_cce" "$CUDA_DIR/bin/$_host_cc"
    elif [ -e "/usr/bin/$_host_cc" ]; then
        ln -sfn "/usr/bin/$_host_cc" "$CUDA_DIR/bin/$_host_cc"
    fi
done
unset _host_cc
ln -sfn "$CUDA_DIR/include" "$CUDA_DIR/targets/$HOST_TRIPLE/include"
ln -sfn "$CUDA_DIR/lib64" "$CUDA_DIR/targets/$HOST_TRIPLE/lib"

printf 'CUDA Version 11.6.0\n' > "$CUDA_DIR/version.txt"

# CUDA-named runtime library symlinks (mirrors cu-bridge's link.json
# pre_make/virtual_cmake sections: "lib64/libcudart.so" -> its runtime).
# Projects linked by a plain host compiler with -lcudart/-lcuda resolve these
# to the bridge runtime; objects compiled through cucc carry wcuda* symbols
# only, so the mapping is exact rather than an ABI guess.
for _cuda_lib in libcudart.so libcudart_static.a libcudadevrt.a libcuda.so libcuda.so.1; do
    ln -sfn "$CUCC_PATH/lib/libcce_bridge_runtime.so" "$CUDA_DIR/lib64/$_cuda_lib"
    ln -sfn "$CUCC_PATH/lib/libcce_bridge_runtime.so" "$CUDA_DIR/lib64/stubs/$_cuda_lib"
done
unset _cuda_lib

# CMake's built-in toolkit probes inspect these paths even when the actual
# compiler is the nvcc shim. Keep them present without inventing NVIDIA libs.
ln -sfn "$CUCC_PATH/cmake_modules" "$CUDA_DIR/cmake_modules"
ln -sfn "$CUCC_PATH/cmake_modules/FindCUDAToolkit.cmake" \
    "$CUDA_DIR/lib64/cmake/CUDAToolkit/FindCUDAToolkit.cmake"
printf 'include(\"${CMAKE_CURRENT_LIST_DIR}/FindCUDAToolkit.cmake\")\n' \
    > "$CUDA_DIR/lib64/cmake/CUDAToolkit/CUDAToolkitConfig.cmake"

printf 'cmake_cce: CUDA shim: %s\n' "$CUDA_DIR" >&2
printf 'cmake_cce: host toolkit layout: %s\n' "$HOST_TRIPLE" >&2
printf 'cmake_cce: Ascend architecture: %s\n' "$CU2CCE_NPU_ARCH" >&2

export CUCC_PATH
export CUDA_PATH="$CUDA_DIR"
export CUDA_HOME="$CUDA_DIR"
export CANN_BASE
export ASCEND_TOOLKIT_HOME
export CU2CCE_NPU_ARCH
export CUCC_NPU_ARCH="$CU2CCE_NPU_ARCH"
export PATH="$CUCC_PATH/bin:$CUDA_DIR/bin:$PATH"
export LD_LIBRARY_PATH="$CUCC_PATH/lib:$CANN_BASE/lib64:$CANN_BASE/runtime/lib64:${LD_LIBRARY_PATH:-}"

args=("$@")
have_arch=0
have_module_path=0
have_runtime=0
have_override=0
for index in "${!args[@]}"; do
    arg="${args[$index]}"
    case "$arg" in
        -DCMAKE_CUDA_ARCHITECTURES=*|-DCMAKE_CUDA_ARCHITECTURES) have_arch=1;;
        -DCMAKE_CUDA_RUNTIME_LIBRARY=*) have_runtime=1;;
        -DCMAKE_CUDA_RUNTIME_LIBRARY) have_runtime=1;;
        -DCMAKE_USER_MAKE_RULES_OVERRIDE*|-DCMAKE_USER_MAKE_RULES_OVERRIDE_CUDA*) have_override=1;;
        -DCMAKE_MODULE_PATH=*)
            have_module_path=1
            user_module_path="${arg#-DCMAKE_MODULE_PATH=}"
            if [ -n "$user_module_path" ]; then
                args[$index]="-DCMAKE_MODULE_PATH=$CUCC_PATH/cmake_modules;$user_module_path"
            else
                args[$index]="-DCMAKE_MODULE_PATH=$CUCC_PATH/cmake_modules"
            fi
            ;;
        -DCMAKE_MODULE_PATH) have_module_path=1;;
    esac
done
if [ "$have_arch" -eq 0 ]; then
    # CMake's generated -gencode flags describe NVIDIA GPUs. ccec selects the
    # Ascend target through CU2CCE_NPU_ARCH instead.
    args+=("-DCMAKE_CUDA_ARCHITECTURES=OFF")
fi
if [ "$have_runtime" -eq 0 ]; then
    # CMake otherwise injects -lcudadevrt/-lcudart_static into host targets
    # that link a CUDA library. Those NVIDIA runtime libraries do not exist on
    # Ascend; CUDA::cudart is provided explicitly by FindCUDAToolkit.cmake.
    args+=("-DCMAKE_CUDA_RUNTIME_LIBRARY=None")
fi
if [ "$have_module_path" -eq 0 ]; then
    args+=("-DCMAKE_MODULE_PATH=$CUCC_PATH/cmake_modules")
fi
args+=("-DCMAKE_CUDA_COMPILER=$CUDA_DIR/bin/nvcc")

# CMake-user-make-rules override: deterministically pin the CUDA compiler
# identity before CMake's stock detection runs. Disable with
# CU2CCE_CMAKE_NO_OVERRIDE=1 to fall back to the pure -DCMAKE_CUDA_* +
# module-path path.
if [ "${CU2CCE_CMAKE_NO_OVERRIDE:-0}" != "1" ] && [ "$have_override" -eq 0 ]; then
    if [ -f "$CUCC_PATH/cmake_modules/override/CUDAOverrides.cmake" ]; then
        args+=("-DCMAKE_USER_MAKE_RULES_OVERRIDE=$CUCC_PATH/cmake_modules/override/CUDAOverrides.cmake")
        args+=("-DCMAKE_USER_MAKE_RULES_OVERRIDE_CUDA=$CUCC_PATH/cmake_modules/override/CUDAOverrides.cmake")
    else
        echo "cmake_cce: override module missing; continuing without override" >&2
    fi
fi

if [ "${CU2CCE_CMAKE_DEBUG:-0}" = "1" ]; then
    printf 'cmake_cce: configure command:' >&2
    printf ' %q' cmake "${args[@]}" >&2
    printf '\n' >&2
fi

exec cmake "${args[@]}"

#!/bin/bash
# cmake_cce —— configure a CUDA CMake project through cucc/ccec.
#
# Usage:
#   export CUCC_PATH=/path/to/cu2cce-bridge/install
#   cmake_cce -S . -B build
#   cmake --build build
#
# The wrapper creates a per-invocation CUDA-toolkit shim for CMake's compiler
# detection. The shim is intentionally left on disk because CMake uses the
# configured compiler again during a later `cmake --build` invocation.

set -euo pipefail

CUCC_PATH="${CUCC_PATH:-}"
CANN_BASE="${CANN_BASE:-/usr/local/Ascend/latest}"
ASCEND_TOOLKIT_HOME="${ASCEND_TOOLKIT_HOME:-/usr/local/Ascend/ascend-toolkit/latest}"
if [ -z "$CUCC_PATH" ] || [ ! -x "$CUCC_PATH/bin/cucc" ]; then
    echo "cmake_cce: CUCC_PATH must point to an installed cu2cce-bridge directory" >&2
    echo "cmake_cce: expected $CUCC_PATH/bin/cucc" >&2
    exit 1
fi
if [ ! -x "$CANN_BASE/bin/ccec" ]; then
    echo "cmake_cce: ccec not found at $CANN_BASE/bin/ccec" >&2
    exit 1
fi

for arg in "$@"; do
    case "$arg" in
        --version|-version|/V|-E|--help*) exec cmake "$@";;
    esac
done

SHIM_ROOT="${TMPDIR:-/tmp}/cu2cce-cmake-shim-$$"
CUDA_DIR="$SHIM_ROOT/cuda"
mkdir -p "$CUDA_DIR/bin" "$CUDA_DIR/include" "$CUDA_DIR/lib64" "$CUDA_DIR/nvvm/libdevice"
ln -sf "$CUCC_PATH/tools/nvcc_entry.sh" "$CUDA_DIR/bin/nvcc"
ln -sfn "$CUCC_PATH/include" "$CUDA_DIR/include/bridge"
ln -sfn "$CUCC_PATH/include/cuda_runtime.h" "$CUDA_DIR/include/cuda_runtime.h"
ln -sfn "$CUCC_PATH/include/cuda_runtime_api.h" "$CUDA_DIR/include/cuda_runtime_api.h"
printf 'CUDA Version 11.6.0\n' > "$CUDA_DIR/version.txt"
printf 'cmake_cce: CUDA shim: %s\n' "$CUDA_DIR" >&2

export CUCC_PATH
export CUDA_PATH="$CUDA_DIR"
export CUDA_HOME="$CUDA_DIR"
export ASCEND_TOOLKIT_HOME
export CANN_BASE
export PATH="$CUCC_PATH/bin:$CUDA_DIR/bin:$PATH"
export LD_LIBRARY_PATH="$CUCC_PATH/lib:$CANN_BASE/lib64:${LD_LIBRARY_PATH:-}"

# CMake's CUDA architecture probing is NVIDIA-specific. cucc/ccec selects the
# Ascend target itself, so disable CMake's generated -gencode flags unless the
# caller explicitly supplied a CMAKE_CUDA_ARCHITECTURES definition.
args=("$@")
have_arch=0
for arg in "${args[@]}"; do
    case "$arg" in
        -DCMAKE_CUDA_ARCHITECTURES=*|-DCMAKE_CUDA_ARCHITECTURES) have_arch=1;;
    esac
done
if [ "$have_arch" -eq 0 ]; then
    args+=("-DCMAKE_CUDA_ARCHITECTURES=OFF")
fi
args+=("-DCMAKE_CUDA_COMPILER=$CUDA_DIR/bin/nvcc")

exec cmake "${args[@]}"
